cat > ~/Desktop/midad-accounting/server/database/migrations/timetable.js << 'EOF'
// server/database/migrations/timetable.js
export function createTimetableTables(db) {
  db.exec(`
    -- 1) إعدادات الجدول
    CREATE TABLE IF NOT EXISTS timetable_settings (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      academic_year TEXT NOT NULL DEFAULT '2025-2026',
      working_days TEXT NOT NULL DEFAULT '[0,1,2,3,4,5]',
      periods_per_day INTEGER NOT NULL DEFAULT 6,
      period_duration INTEGER NOT NULL DEFAULT 45,
      day_start_time TEXT NOT NULL DEFAULT '08:00',
      breaks TEXT DEFAULT '[]',
      is_active INTEGER DEFAULT 1,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
    );

    -- 2) المواد المطلوب توزيعها
    CREATE TABLE IF NOT EXISTS timetable_subjects (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      grade TEXT NOT NULL,
      section TEXT,
      subject_code TEXT NOT NULL,
      subject_name TEXT NOT NULL,
      weekly_lessons INTEGER NOT NULL DEFAULT 1,
      academic_year TEXT NOT NULL DEFAULT '2025-2026',
      notes TEXT,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
    );

    CREATE INDEX IF NOT EXISTS idx_tt_subjects_grade ON timetable_subjects(grade, section);
    CREATE INDEX IF NOT EXISTS idx_tt_subjects_year ON timetable_subjects(academic_year);

    -- 3) معلمو المادة (يدعم أكثر من معلم للمادة)
    CREATE TABLE IF NOT EXISTS timetable_subject_teachers (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      subject_id INTEGER NOT NULL,
      teacher_id INTEGER NOT NULL,
      lessons_count INTEGER NOT NULL DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (subject_id) REFERENCES timetable_subjects(id) ON DELETE CASCADE,
      FOREIGN KEY (teacher_id) REFERENCES users(id) ON DELETE CASCADE,
      UNIQUE(subject_id, teacher_id)
    );

    CREATE INDEX IF NOT EXISTS idx_tt_subject_teachers_subject ON timetable_subject_teachers(subject_id);
    CREATE INDEX IF NOT EXISTS idx_tt_subject_teachers_teacher ON timetable_subject_teachers(teacher_id);
  `);
}
EOF
echo "✅ تم تصحيح migrations/timetable.js"
